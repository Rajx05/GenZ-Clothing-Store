# ======================
# Server
# ======================
# Port is read from the PORT env var (set by Render automatically) and
# falls back to 3000 locally.

# Comma-separated list of allowed frontend origins. On Render set this to
# your Vercel URL(s), e.g.:
# CORS_ORIGIN=https://my-store.vercel.app

# Set to "production" on Render so the refresh cookie is sent as
# SameSite=None; Secure (required for cross-site frontend -> backend auth).
# NODE_ENV=production

# ======================
# Database
# ======================
MONGO_URI=mongodb://localhost:27017/auth_db

# ======================
# Auth (JWT)
# ======================
JWT_SECRET=your_jwt_secret_here

# ======================
# Email (Gmail OAuth2) — used to send OTP verification emails
# ======================
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_password
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_USER_EMAIL=your_email@gmail.com

# ======================
# Razorpay payments
# ======================
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
